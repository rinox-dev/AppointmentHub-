<?xml version="1.0" encoding="UTF-8"?>
<!--
  AppointmentHub - Appointment Booking and Management System (PDR v1.0)

  The application itself (REST API + business logic) is plain Java. The only
  runtime dependency is Gson, used to read and write JSON. Supporting
  dependencies are documented in docs/README-dependencies.md.

  Test scope dependencies: JUnit 5 (component + API tests) and Selenium
  WebDriver (UI automation).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>com.appointmenthub</groupId>
  <artifactId>appointmenthub</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>AppointmentHub</name>
  <description>Appointment booking and management system: Java REST API, web interface and QA test automation.</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.release>17</maven.compiler.release>

    <!-- Supporting dependency versions (documented in docs/README-dependencies.md) -->
    <gson.version>2.11.0</gson.version>
    <junit.version>5.10.2</junit.version>
    <selenium.version>4.25.0</selenium.version>

    <surefire.version>3.2.5</surefire.version>
    <shade.version>3.5.1</shade.version>
    <exec.version>3.2.0</exec.version>

    <!--
      Test selection:
        default                  -> component + API tests (no browser required)
        -Pui-tests               -> UI (Selenium) tests only
      The 'ui' JUnit tag marks tests that need a real browser.
    -->
    <test.groups></test.groups>
    <test.excludedGroups>ui</test.excludedGroups>

    <!-- UI test settings, overridable from the command line (see docs/test-plan.md) -->
    <app.base.url></app.base.url>
    <browser>chrome</browser>
    <headless>true</headless>
  </properties>

  <dependencies>
    <!-- Runtime dependency: JSON parsing/serialisation for the REST API -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>${gson.version}</version>
    </dependency>

    <!-- Test dependencies -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.seleniumhq.selenium</groupId>
      <artifactId>selenium-java</artifactId>
      <version>${selenium.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>appointmenthub</finalName>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.version}</version>
        <configuration>
          <groups>${test.groups}</groups>
          <excludedGroups>${test.excludedGroups}</excludedGroups>
          <systemPropertyVariables>
            <app.base.url>${app.base.url}</app.base.url>
            <browser>${browser}</browser>
            <headless>${headless}</headless>
          </systemPropertyVariables>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>${exec.version}</version>
        <configuration>
          <mainClass>com.appointmenthub.App</mainClass>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>${shade.version}</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.appointmenthub.App</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Runs only the Selenium UI tests: mvn test -Pui-tests -->
    <profile>
      <id>ui-tests</id>
      <properties>
        <test.groups>ui</test.groups>
        <test.excludedGroups>none</test.excludedGroups>
      </properties>
    </profile>

    <!-- Runs every test (component + API + UI): mvn test -Pall-tests -->
    <profile>
      <id>all-tests</id>
      <properties>
        <test.groups></test.groups>
        <test.excludedGroups>none</test.excludedGroups>
      </properties>
    </profile>
  </profiles>

</project>
